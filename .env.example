# Stripe Checkout (server only — never prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_xxx
# Public address of the live site, used for Stripe return links (defaults to the request origin)
SITE_URL=https://www.example.co.uk
# Commercial rules. Leave unset until the business has confirmed them; nothing is assumed.
# MIN_ORDER_PENCE=0
# DELIVERY_CHARGE_PENCE=0
# Set to true once Stripe Tax is enabled and the business is VAT registered
# STRIPE_AUTOMATIC_TAX=false
